
<!DOCTYPE html>
<html>
<head>
    <title>Calculator</title>
    <style>
        body {
            font-family: Arial;
            display: flex;
            justify-content: center;
            margin-top: 40px;
            background: #eee;
        }
        .calculator {
            background: #222;
            padding: 20px;
            border-radius: 12px;
            width: 280px;
        }
        #display {
            width: 100%;
            box-sizing: border-box;
            height: 55px;
            font-size: 25px;
            text-align: right;
            margin-bottom: 12px;
        }
        .buttons {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 8px;
        }
        button {
            padding: 16px 5px;
            font-size: 18px;
            border: none;
            border-radius: 6px;
            cursor: pointer;
        }
        .op { background: orange; }
        .equal {
            background: lightgreen;
            grid-column: span 3;
        }
        .power { background: white; }
    </style>
</head>
<body>

<div class="calculator">
    <input id="display" readonly>
    <div class="buttons" id="buttons"></div>
</div>

<script>
    const display = document.getElementById("display");
    const buttons = document.getElementById("buttons");
    let resultShown = false;

    const keys = [
        ["C", "⌫", "√", "÷"],
        ["7", "8", "9", "×"],
        ["4", "5", "6", "−"],
        ["1", "2", "3", "+"],
        ["%", "0", ".", "x²"],
        ["=", "^"]
    ];

    keys.flat().forEach(key => {
        const b = document.createElement("button");
        b.textContent = key;
        b.onclick = () => press(key);

        if ("÷×−+".includes(key)) b.className = "op";
        if (key === "=") b.className = "equal";
        if (key === "^") b.className = "power";

        buttons.appendChild(b);
    });

    function press(key) {
        if (key === "C") {
            display.value = "";
            resultShown = false;
        } else if (key === "⌫") {
            display.value = display.value.slice(0, -1);
            resultShown = false;
        } else if (key === "=") {
            try {
                let exp = display.value;
                if (!exp || !/^[\d+\-*/%.()\s]+$/.test(exp))
                    throw Error();

                let n = Function('"use strict";return (' + exp + ')')();
                if (!Number.isFinite(n)) throw Error();

                display.value = n;
                resultShown = true;
            } catch {
                display.value = "Error";
                resultShown = true;
            }
        } else if (key === "√" || key === "x²") {
            let n = Number(display.value);
            if (!display.value || (key === "√" && n < 0)) {
                display.value = "Error";
            } else {
                display.value = key === "√" ? Math.sqrt(n) : n * n;
            }
            resultShown = true;
        } else {
            if (resultShown && /[\d.]/.test(key))
                display.value = "";

            display.value += ({
                "÷": "/", "×": "*", "−": "-", "^": "**"
            }[key] || key);

            resultShown = false;
        }
    }

    // Keep the power button at column 4 and "=" across columns 1–3.
    buttons.children[20].style.gridColumn = "span 3";
    buttons.children[21].style.gridColumn = "4";
</script>

</body>
</html>
